
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GraphQLSchemaOutputDir>$(MSBuildProjectDirectory)/Schemas</GraphQLSchemaOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amiasea.Enterprise.Endpoint.Core" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore.CommandLine" Version="16.6.8" />
  </ItemGroup>

  <Target Name="ExportGraphQLSchemas" Condition="'$(Configuration)' == 'Release'">
    <MakeDir Directories="$(GraphQLSchemaOutputDir)" />
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectFullPath)&quot; --configuration Release -- schema export --schema-name Core --output &quot;$(GraphQLSchemaOutputDir)/Core.graphql&quot;" />
  </Target>
</Project>