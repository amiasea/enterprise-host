
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GraphQLSchemaOutputDir>$(MSBuildProjectDirectory)/Schemas</GraphQLSchemaOutputDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug' and '$(UseEndpointPackage)' != 'true'">
    <ProjectReference Include="../../../endpoint/core/src/Amiasea.Enterprise.Endpoint.Core/Amiasea.Enterprise.Endpoint.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release' or '$(UseEndpointPackage)' == 'true'">
    <PackageReference Include="Amiasea.Enterprise.Endpoint.Core" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore.CommandLine" Version="16.6.8" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <None Include="$(GraphQLSchemaOutputDir)/**/*.graphql"
          Pack="true"
          PackagePath="Schemas/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="ExportGraphQLSchemas"
          Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(GraphQLSchemaOutputDir)" />
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectFullPath)&quot; --no-build -- schema export --schema-name Core --output &quot;$(GraphQLSchemaOutputDir)/Core.graphql&quot;" />
  </Target>
</Project>